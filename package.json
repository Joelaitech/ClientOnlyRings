    "three": "^0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@vitejs/plugin-react": "^4.3.3",
    "draco3dgltf": "^1.5.7",
    "vite": "^5.4.10"
